{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "keyVaultPublicNetworkAccess": {
      "value": "${KEY_VAULT_PUBLIC_NETWORK_ACCESS}"
    },
    "enableKeyVaultPrivateEndpoint": {
      "value": "${ENABLE_KEY_VAULT_PRIVATE_ENDPOINT}"
    },
    "foundryModelVersion": {
      "value": "${FOUNDRY_MODEL_VERSION}"
    },
    "gatewayTokenLimitPerMinute": {
      "value": "${GATEWAY_TOKEN_LIMIT_PER_MINUTE}"
    }
  }
}
